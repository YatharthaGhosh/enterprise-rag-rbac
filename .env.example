# Any OpenAI-compatible LLM endpoint. Groq's free tier is the default.
#   Groq:   https://console.groq.com/keys          LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini: https://aistudio.google.com/apikey     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama: (local, no key)                        LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# "low" saves tokens on reasoning models (gpt-oss); leave empty for models without it
LLM_REASONING_EFFORT=low

# Optional: Qdrant server/Cloud instead of the embedded on-disk store
QDRANT_URL=
QDRANT_API_KEY=

JWT_SECRET=change-me

# Hugging Face write token (deploy only)
HF_TOKEN=
